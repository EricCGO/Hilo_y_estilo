# ==========================================================
# Copia este archivo a .env y rellena los valores.
# .env está ignorado por Git. NUNCA subas credenciales reales.
# Genera secretos con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ==========================================================

DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Obligatorio: clave de firma JWT y de Django. Genera una nueva.
SECRET_KEY=

# MySQL: la API usa hilo_y_estilo_api (NO hilo_y_estilo, que es legacy).
DB_NAME=hilo_y_estilo_api
DB_USER=hilo_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Base dedicada para `manage.py test` (Django la crea y destruye).
DB_TEST_NAME=hilo_y_estilo_test

# CORS / seguridad
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (cookies httpOnly)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AUTH_COOKIE_ACCESS_NAME=access_token
AUTH_COOKIE_REFRESH_NAME=refresh_token
AUTH_COOKIE_REFRESH_PATH=/api/v1/auth/
AUTH_COOKIE_SAMESITE=Lax          # Lax | Strict | None (None exige Secure)
AUTH_COOKIE_DOMAIN=               # vacío = host actual
AUTH_COOKIE_SECURE=False          # en producción con HTTPS: True

# Throttling DRF por IP
THROTTLE_LOGIN_RATE=10/min
THROTTLE_REGISTER_RATE=5/min
THROTTLE_REFRESH_RATE=30/min
DRF_NUM_PROXIES=0                 # 1 si estás detrás de un proxy inverso

# Usuario admin creado por `manage.py seed_datos`. Genera una clave nueva.
SEED_ADMIN_EMAIL=admin@hiloystilo.local
SEED_ADMIN_PASSWORD=
# Opcional: contraseña para los usuarios de prueba creados con `seed_datos --demo`.
SEED_DEMO_PASSWORD=
